# Base de datos (Neon) — pooled para runtime, directa para migraciones
DATABASE_URL="postgresql://user:pass@ep-xxx-pooler.region.aws.neon.tech/db?sslmode=require&pgbouncer=true"
DIRECT_URL="postgresql://user:pass@ep-xxx.region.aws.neon.tech/db?sslmode=require"

# Clerk (auth multi-tenant vía Organizations = tenants)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=""
CLERK_SECRET_KEY=""

# Stripe
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""

# Mercado Pago (opcional, para LatAm)
MERCADOPAGO_ACCESS_TOKEN=""

# Resend (email transaccional)
RESEND_API_KEY=""

# Inngest (jobs en background — claves de https://app.inngest.com)
INNGEST_EVENT_KEY=""
INNGEST_SIGNING_KEY=""

# Vercel Blob (adjuntos)
BLOB_READ_WRITE_TOKEN=""
